{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FullSceneOCR",
  "version": "1.8.0",
  "identifier": "com.fullscene.ocr",
  "build": {
    "frontendDist": "../../shared-ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "全场景OCR翻译系统",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.siliconflow.cn https://api.openai.com https://api.anthropic.com http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "全场景 OCR 翻译工具",
    "longDescription": "软件主体（Rust）与浏览器扩展双端平级，支持截图OCR、划词翻译、全文翻译、AI对话"
  }
}